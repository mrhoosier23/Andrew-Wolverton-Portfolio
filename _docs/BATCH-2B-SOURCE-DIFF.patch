--- /mnt/data/Andrew-Portfolio-Batch-2-Home-Polish/styles/desktop.css	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/Andrew-Portfolio-Batch-2B-Desktop-Correction/styles/desktop.css	2026-08-06 02:36:06.824439550 +0000
@@ -0,0 +1,270 @@
+/* Batch 2B: desktop visual correction layer
+   This file is loaded after shared components and before responsive rules.
+   It owns desktop composition for the pages corrected in this batch. */
+
+@media (min-width: 821px) {
+  /* Shared header: compact, consistent, and never wider than the content system. */
+  .site-header { width: min(calc(100% - 32px), 1180px); }
+  .site-header__inner { min-height: 62px; padding: 7px 8px 7px 12px; border-radius: 17px; }
+  .brand-mark { width: 38px; height: 38px; border-radius: 11px; }
+  .brand-copy strong { font-size: .95rem; }
+  .brand-copy small { font-size: .68rem; }
+  .site-nav { gap: 2px; }
+  .site-nav > a { min-height: 42px; padding: 9px 12px; font-size: .94rem; }
+  .site-nav > a.nav-contact { padding-inline: 17px; }
+
+  /* Homepage hero */
+  .page-home .desk-hero { min-height: 700px; height: min(88svh, 820px); }
+  .page-home .desk-image { background-position: center 50%; }
+  .page-home .desk-shade {
+    background:
+      linear-gradient(90deg, rgba(3,15,12,.52) 0%, rgba(3,15,12,.20) 42%, rgba(3,15,12,.02) 72%),
+      linear-gradient(180deg, rgba(2,11,9,.06), rgba(2,11,9,.22));
+  }
+  .page-home .hero-copy.hero-copy-wall-card {
+    top: clamp(116px, 14vh, 138px);
+    left: max(var(--gutter), calc((100vw - var(--max)) / 2));
+    width: min(510px, 38vw);
+    padding: 26px 28px 28px;
+    border-color: rgba(255,255,255,.82);
+    border-radius: 22px;
+    box-shadow: 0 22px 54px rgba(2,18,14,.22);
+  }
+  .page-home .hero-copy.hero-copy-wall-card .eyebrow { margin-bottom: 10px; font-size: .72rem; }
+  .page-home .hero-copy.hero-copy-wall-card h1 {
+    margin-bottom: 16px;
+    font-size: clamp(3.3rem, 3.85vw, 4.1rem);
+    line-height: .88;
+    letter-spacing: -.048em;
+  }
+  .page-home .hero-copy.hero-copy-wall-card .hero-lede { max-width: 35ch; font-size: 1rem; line-height: 1.46; }
+  .page-home .hero-copy.hero-copy-wall-card .hero-actions { margin-top: 20px; }
+  .page-home .hero-copy.hero-copy-wall-card .button { min-height: 44px; padding: 10px 17px; font-size: .94rem; }
+
+  /* Single-image iPod: the SVG owns the screen and wheel. */
+  .page-home .desk-ipod {
+    right: max(34px, calc((100vw - 1320px) / 2));
+    bottom: 24px;
+    width: clamp(142px, 11vw, 174px);
+    transform: rotate(2deg);
+  }
+  .page-home .desk-ipod > img {
+    display: block !important;
+    width: 100% !important;
+    height: auto !important;
+    opacity: 1 !important;
+    visibility: visible !important;
+  }
+  .page-home .desk-ipod-label {
+    right: calc(100% - 8px);
+    top: 17%;
+    width: 158px;
+    padding: 9px 12px;
+  }
+
+  /* Selected work cards: a stable 2x2 layout with no image/text collision. */
+  .page-home .home-selected-work { padding-top: 82px; padding-bottom: 88px; }
+  .page-home .home-selected-work .section-intro { margin-bottom: 28px; }
